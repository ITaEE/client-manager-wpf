<Window x:Class="Portfolio.ClientManager.App.Views.ClientEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="540"
        Height="600"
        MinWidth="480"
        MinHeight="540"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock FontSize="23" FontWeight="SemiBold" Text="{Binding WindowTitle}" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="Keep contact details and relationship status up to date." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Full name *" />
                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Status" />
                <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Phone" />
            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,14">
            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Email" />
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,0,0,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Notes" />
            <TextBox Grid.Row="1"
                     MinHeight="110"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
        </Grid>

        <StackPanel Grid.Row="5" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Margin="0,0,10,0"
                    IsCancel="True"
                    Command="{Binding CancelCommand}"
                    Content="Cancel"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button IsDefault="True"
                    Command="{Binding SaveCommand}"
                    Content="Save"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
